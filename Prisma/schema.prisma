generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


model Admin {
  idAdmin  String @id @default(uuid())
  name     String
  rol      String @default("admin")
  email    String @unique
  password String
}


model Student {
  idStudent  String       @default(uuid())
  rol        String       @default("student")
  expedient  String       @id @unique
  fullName   String
  career     String
  semester   String
  advisories Advisories[]
}

model Advisories {
  idAdvisory    String    @id @default(uuid())
  expStudent    String
  studentName   String?
  cveMaestro    String
  teacherName   String?
  title         String?
  advisoryDate  DateTime?
  status        String    @default("Pending") 
  creation_date DateTime  @default(now())


  // Relaciones
  student Student @relation(fields: [expStudent], references: [expedient])
  
}