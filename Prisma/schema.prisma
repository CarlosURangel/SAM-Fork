generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String  @id @default(uuid())
  nombre     String
  correo     String  @unique
  expediente String  @unique
}

model Asesoria {
  id                BigInt     @id @default(autoincrement())
  nombre_alumno     String     @db.VarChar(100)
  nombre_profesor   String     @db.VarChar(100)
  carrera           String     @db.VarChar(100)
  expediente_alumno String     @db.VarChar(10)
  id_materia        Int
  tema              String?    @db.Text
  fecha             DateTime

  materia           Materia    @relation(fields: [id_materia], references: [id])
}

model Materia {
  id         Int         @id @default(autoincrement())
  nombre     String      @db.VarChar(100)
  asesorias  Asesoria[]
}

model Administrador {
  id             Int     @id @default(autoincrement())
  nombre_usuario String  @db.VarChar(50)
  password       String  @db.VarChar(60)
}